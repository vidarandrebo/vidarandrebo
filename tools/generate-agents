#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

INSTRUCTIONS_DIR="${1:-$REPO_ROOT/instructions}"
OUTPUT_FILE="${2:-$INSTRUCTIONS_DIR/AGENTS.md}"

TMP_FILE="$(mktemp)"
trap 'rm -f "$TMP_FILE"' EXIT

if [ -f "$INSTRUCTIONS_DIR/common.md" ]; then
  cat "$INSTRUCTIONS_DIR/common.md" > "$TMP_FILE"
else
  echo "# Coding Guidelines & Preferences" > "$TMP_FILE"
fi

find "$INSTRUCTIONS_DIR/languages" -mindepth 2 -maxdepth 2 -name "instructions.md" | sort | while IFS= read -r file; do
  echo "" >> "$TMP_FILE"
  awk '
    BEGIN {
      in_fm = 0
      done_fm = 0
      content = ""
    }
    /^---$/ {
      if (!done_fm && in_fm == 0) { in_fm = 1; next }
      if (!done_fm && in_fm == 1) { in_fm = 0; done_fm = 1; next }
    }
    {
      if (done_fm || (!in_fm && !done_fm)) {
        line = $0
        gsub(/\xC2\xA0/, " ", line)
        if (line ~ /^[[:space:]]*$/) {
          line = ""
        } else if (line ~ /^#/) {
          line = "#" line
        }
        content = content line "\n"
      }
    }
    END {
      sub(/^[[:space:]\n]+/, "", content)
      sub(/[[:space:]\n]+$/, "", content)
      if (content != "") {
        print content
      }
    }
  ' "$file" >> "$TMP_FILE"
done

echo "" >> "$TMP_FILE"

mv "$TMP_FILE" "$OUTPUT_FILE"
echo "Generated $OUTPUT_FILE"
